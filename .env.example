# ============================================================
# SLOGI v76.1.0 — Cian Shared Workspace
# Environment variable template
# DO NOT PUT REAL SECRETS INTO THIS FILE
# ============================================================


# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------

SUPABASE_URL=

# Public browser key only.
# Never expose the service_role key to browser code.
SUPABASE_PUBLISHABLE_KEY=

# Supabase provides this automatically to deployed Edge Functions.
# For local Edge Function work, put the real value only in an ignored
# local env file; keep this committed template empty.
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------
# Browserless
# Backend secret.
# Used only by server-side Cian discovery, hydration and manual import.
# ------------------------------------------------------------

BROWSERLESS_TOKEN=

# Optional Browserless endpoint override.
BROWSERLESS_URL=


# ------------------------------------------------------------
# Yandex server-side geocoder
# Backend secret.
# Different from browser Maps API key.
# ------------------------------------------------------------

YANDEX_GEOCODER_API_KEY=


# ------------------------------------------------------------
# Cian-only listing refresh
# ------------------------------------------------------------

CIAN_COMMERCIAL_RENT_SEARCH_URL=
SLOGI_LISTING_CRON_SECRET=
SLOGI_LISTING_DISCOVERY_RUNTIME_MS=
SLOGI_LISTING_HYDRATION_RUNTIME_MS=
SLOGI_LISTING_REFRESH_MAX_BACKFILL_PAGE=

# Shared workspace join service. Keep the pepper only in Edge secrets or an
# ignored local env file. Workspace codes are never environment templates.
SLOGI_WORKSPACE_CODE_PEPPER=
