# ============================================================
# SLOGI v76.0.1
# Environment variable template
# DO NOT PUT REAL SECRETS INTO THIS FILE
# ============================================================


# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public browser key only.
# Never expose the service_role key to browser code.
SUPABASE_PUBLISHABLE_KEY=

# Supabase provides this automatically to deployed Edge Functions.
# For local Edge Function work, put the real value only in an ignored
# local env file; keep this committed template empty.
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------
# Browserless
# Backend secret.
# Used by market listing import/search functions.
# ------------------------------------------------------------

BROWSERLESS_TOKEN=

# Optional Browserless endpoint override.
BROWSERLESS_URL=


# ------------------------------------------------------------
# Yandex server-side geocoder
# Backend secret.
# Different from browser Maps API key.
# ------------------------------------------------------------

YANDEX_GEOCODER_API_KEY=


# ------------------------------------------------------------
# Optional marketplace URL overrides
# ------------------------------------------------------------

CIAN_COMMERCIAL_RENT_SEARCH_URL=
AVITO_COMMERCIAL_RENT_SEARCH_URL=
